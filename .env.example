# ===================================================================
# SMS Project Configuration Environment Variables
# ===================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the '.env' file with real credentials to GitHub.

# Django Security Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# ===================================================================
# IPROG SMS Provider (https://www.iprogsms.com) — ACTIVE PROVIDER
# ===================================================================
# Sign up at https://www.iprogsms.com/register and verify as a Student.
# Student accounts receive 5 free SMS credits plus free daily test SMS.
# Copy the token from API Settings into IPROG_API_TOKEN.
# Leave it empty to run in simulation mode.
IPROG_API_TOKEN=
IPROG_API_URL=https://www.iprogsms.com/api/v1/sms_messages
IPROG_STATUS_URL=https://www.iprogsms.com/api/v1/sms_messages/status

# ===================================================================
# Textbelt Provider (LEGACY fallback — not used by the app)
# ===================================================================
# Philippine carriers commonly block unregistered foreign senders, so the
# active provider is IPROG SMS. Kept so the legacy service still runs.
TEXTBELT_API_KEY=textbelt
TEXTBELT_API_URL=https://textbelt.com/text
TEXTBELT_STATUS_URL=https://textbelt.com/status

# Simulation Toggle:
# True  -> never sends a real SMS; returns a mocked success (safe for demos/tests).
# False -> sends for real through IPROG (requires IPROG_API_TOKEN and credits).
SMS_SIMULATION_MODE=False
