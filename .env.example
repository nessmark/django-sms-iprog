# ===================================================================
# SMS Project Configuration Environment Variables
# ===================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the '.env' file with real credentials to GitHub.

# Django Security Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# TxtLink SMS Provider Credentials
# Obtain your API Key from the TextLink dashboard (https://textlinksms.com)
TXTLINK_API_KEY=your_txtlink_api_key_here
TXTLINK_API_URL=https://textlinksms.com/api/send-sms

# Simulation Mode Toggle:
# Set to 'True' to test sending SMS without spending real API credits or if you do not have an API key yet.
# Set to 'False' to send real SMS through the live TxtLink gateway.
TXTLINK_SIMULATION_MODE=False
